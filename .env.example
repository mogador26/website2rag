# Copier ce fichier en ".env" (ne jamais le versionner) et choisir UN bloc.

# --- Option A : OpenAI ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-...

# --- Option B : modèle local via Ollama (gratuit, aucune donnée ne sort) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.1            # un modèle multimodal (ex. llava) est requis pour --images

# --- Option C : autre service compatible OpenAI (Mistral, Groq, OpenRouter...) ---
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.mistral.ai/v1
# LLM_MODEL=mistral-small-latest
# LLM_API_KEY=...

# --- Option D : Anthropic ---
# LLM_PROVIDER=anthropic
# LLM_MODEL=<nom du modèle>
# LLM_API_KEY=sk-ant-...

# Optionnel (recherche)
# RAG_DB=db
# RAG_EMBED_MODEL=BAAI/bge-m3
# RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
